generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONTRIBUTOR
  ADMIN
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  picks          Pick[]
  scores         Score[]
  driverEnergies DriverEnergy[]
  energyEvents   EnergyEvent[]
}

model Race {
  id        Int          @id @default(autoincrement())
  name      String
  location  String
  date      DateTime
  deadline  DateTime?    // Deadline de soumission (FP3). Si null, utilise date.
  round     Int
  season    Int
  hasSprint    Boolean       @default(false)
  picks        Pick[]
  result       RaceResult?
  scores       Score[]
  energyEvents EnergyEvent[]

  @@unique([round, season])
}

model Pick {
  id                 String   @id @default(cuid())
  userId             String
  raceId             Int
  driver1            String
  driver2            String
  team               String
  strategy           String   // Code de la stratégie choisie
  drsTarget          String?  // UserId cible pour la stratégie DRS
  huileMoteurTarget  String?  // Code pilote cible pour la stratégie Huile moteur
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  race               Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([userId, raceId])
}

model DriverEnergy {
  id         String @id @default(cuid())
  userId     String
  driverCode String
  energy     Float  @default(1.0) // 0.0 à 1.0 (0% à 100%)
  season     Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, driverCode, season])
}

// Journal chronologique des mutations d'énergie (une ligne = énergie d'un pilote
// pour un utilisateur après un événement donné). Permet de rejouer la saison en
// avant après l'édition d'une course passée, plutôt que d'inverser un delta sur
// une valeur qui a pu être clampée (0-100%), ce qui est non réversible.
model EnergyEvent {
  id          String   @id @default(cuid())
  userId      String
  driverCode  String
  season      Int
  round       Int      // round de la course (RACE), ou dernier round joué au moment du clic (MANUAL)
  source      String   // "RACE" | "MANUAL"
  raceId      Int?     // renseigné si source = RACE
  delta       Float?   // renseigné si source = MANUAL (delta brut appliqué avant clamp)
  energyAfter Float    // énergie résultante (0.0–1.0) après cet événement
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  race        Race?    @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([userId, driverCode, raceId])
  @@index([userId, driverCode, season, round, createdAt])
}

model RaceResult {
  id               Int            @id @default(autoincrement())
  raceId           Int            @unique
  fastestLap       String         // Code pilote avec le meilleur tour (course principale)
  hasRedFlag       Boolean        @default(false)
  hasSprintRedFlag Boolean        @default(false) // Drapeau rouge en course sprint
  driverResults    DriverResult[]
  race             Race           @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

model DriverResult {
  id             String     @id @default(cuid())
  raceResultId   Int
  driverCode     String
  // Course principale
  qualifyingPos  Int?       // Position en qualifs (1-20) = grille de départ. Null si absent.
  racePos        Int?       // Position d'arrivée. Null si DNF/DNS.
  isDnf          Boolean    @default(false)
  // Sprint (week-end sprint uniquement)
  sprintQualiPos Int?       // Position en sprint qualifying (SQ1/SQ2/SQ3) = grille sprint.
  sprintRacePos  Int?       // Position d'arrivée du sprint. Null si DNF/DNS.
  sprintIsDnf    Boolean    @default(false)
  // Scoring pré-calculé (base, sans multiplicateur énergie/stratégie)
  scoringQualiPts      Float?   // Points de qualifications
  scoringRacePts       Float?   // Points de course (F1 pts + pos gain/loss + FL + DNF)
  scoringSprintQualiPts Float?  // Points de sprint qualifying
  scoringSprintRacePts Float?   // Points de sprint course
  scoringPosGainPts    Float?   // Points issus des places remontées (inclus dans scoringRacePts)
  scoringPosLost       Boolean? // A perdu des places par rapport à la grille
  raceResult     RaceResult @relation(fields: [raceResultId], references: [id], onDelete: Cascade)

  @@unique([raceResultId, driverCode])
}

model Score {
  id        String  @id @default(cuid())
  userId    String
  raceId    Int
  points    Int
  breakdown String? // JSON sérialisé de ScoreBreakdown
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  race      Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([userId, raceId])
}

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
